# CarQR Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server
PORT=3000
# Public URL of your app (for QR codes, Twilio webhooks)
# Local dev: use ngrok URL for Twilio to reach your machine
# Production: https://your-app.railway.app or your domain
APP_URL=http://localhost:3000

# Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase (https://console.firebase.google.com)
# Project Settings → Service Accounts → Generate new private key
# FIREBASE_PRIVATE_KEY: wrap in quotes, use \n for line breaks
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Optional: for future auth/sessions
APP_SECRET=
